    "import functools\n",
    "\n",
    "def log_execution(func):\n",
    "    @functools.wraps(func)\n",
    "    def wrapper(*args, **kwargs):\n",
    "        func_name = func.__name__\n",
    "\n",
    "        # Log function execution, positional arguments (*args), and keyword arguments (**kwargs)\n",
    "        print(f\"[LOG] Executing '{func_name}'\")\n",
    "        print(f\"      Positional args (*args): {args}\")\n",
    "        print(f\"      Keyword args (**kwargs): {kwargs}\")\n",
    "\n",
    "        result = func(*args, **kwargs)\n",
    "        return result\n",
    "    return wrapper\n",
    "class BankAccount:\n",
    "    def __init__(self, owner_name, balance = 0.0):\n",
    "        self.owner_name = owner_name\n",
    "        self.balance = balance\n",
    "    @log_execution\n",
    "    def deposit(self, *amounts):\n",
    "        total_added = sum(amounts)\n",
    "        self.balance += total_added\n",
    "        print(f\"{total_added} has been successfully deposited into account\")\n",
    "        return self.balance"
   ]
  },
